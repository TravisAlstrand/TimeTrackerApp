<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjectTimeTracker.MainPage"
             BackgroundColor="#FF545454">

    <VerticalStackLayout Padding="20" Spacing="15" HorizontalOptions="Center" VerticalOptions="Center">
      <Entry Placeholder="Project Name" x:Name="ProjectNameEntry" />
      <HorizontalStackLayout Spacing="10">
        <Button Text="Start" Clicked="StartButton_Clicked"/>
        <Button Text="Stop" Clicked="StopButton_Clicked"/>
      </HorizontalStackLayout>
      <CollectionView ItemsSource="{Binding Sessions}">
        <CollectionView.ItemTemplate>
          <DataTemplate>
            <Label Text="{Binding ProjectName}" />
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
    </VerticalStackLayout>
</ContentPage>
